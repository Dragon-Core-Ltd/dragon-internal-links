{
	"name": "dragoncore/dragon-internal-links",
	"description": "Find internal linking opportunities and orphan content",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Dragon Core",
			"homepage": "https://dcplugins.com"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"autoload": {
		"psr-4": {
			"DragonInternalLinks\\": "includes/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
